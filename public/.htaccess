# Portfolio CMS - Apache front controller
#
# 1. serve real files and the built SPA assets directly;
# 2. route every other path (pages, APIs, admin, sitemap) through index.php;
# 3. harden headers, compression and caching.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Respect the proxy/HTTPS of the hosting platform.
    RewriteCond %{HTTP:X-Forwarded-Proto} =https
    RewriteRule ^ - [E=HTTPS:on]

    # Real files (assets, uploads, fonts) are served as-is.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else goes to the front controller with the original path.
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Cross-Origin-Opener-Policy "same-origin"

    # Immutable, content-hashed bundles.
    <FilesMatch "\.(js|css|woff2|woff|webp|avif|png|jpg|jpeg|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Never expose dotfiles or the environment file to the browser.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

Options -Indexes
DirectoryIndex index.php

<IfModule mod_php.c>
    php_flag display_errors off
    php_value upload_max_filesize 12M
    php_value post_max_size 13M
</IfModule>
