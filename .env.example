# ---------------------------------------------------------------------------
# Portfolio CMS — environment template
# Copy to .env and adjust. Never commit the real .env file.
# ---------------------------------------------------------------------------

APP_NAME="Arash Mahdavi — Full-Stack Web Developer"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com
APP_TIMEZONE=UTC
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_KEY=change-me-to-a-64-character-random-string

# --- Database ---------------------------------------------------------------
# mysql  → production (php artisan-style install image below)
# sqlite → zero-config local/dev installs (file path relative to storage/)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=portfolio_cms
DB_USERNAME=portfolio
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_SQLITE_PATH=storage/database.sqlite

# --- Sessions & cookies -----------------------------------------------------
SESSION_NAME=portfolio_session
SESSION_LIFETIME=7200
SESSION_SECURE=true
SESSION_SAME_SITE=Lax

# --- Login hardening --------------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_WINDOW_MINUTES=15

# --- Media ------------------------------------------------------------------
MEDIA_DRIVER=local
MEDIA_MAX_SIZE=5242880
MEDIA_WEBP=true

# --- Mail (smtp | mail | log) ----------------------------------------------
MAIL_TRANSPORT=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME="Arash Mahdavi"

# --- Default admin (used by `npm run db:install`) ---------------------------
ADMIN_NAME="Arash Mahdavi"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD="ChangeMe!2026"

# --- Misc -------------------------------------------------------------------
LOG_LEVEL=warning
CONTENT_SECURITY_POLICY=
