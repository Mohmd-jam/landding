# Environment & secrets
.env
.env.*.local

# Dependencies
node_modules/
vendor/

# Framework caches / runtime
storage/*.sqlite
storage/logs/*
storage/cache/*
storage/sessions/*
storage/mail/*
storage/backups/*
!storage/.gitkeep
!storage/logs/.gitkeep
!storage/cache/.gitkeep
!storage/sessions/.gitkeep
!storage/mail/.gitkeep
!storage/backups/.gitkeep

# Built frontend bundle (generated by `npm run build`);
# the HTML shells and the favicon are hand-written source and stay tracked.
public/app/assets/
public/app/*.map

# Uploaded media — keep the folder, the hardening file and the seed assets
public/uploads/*
!public/uploads/.htaccess
!public/uploads/.gitkeep
!public/uploads/seed/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
